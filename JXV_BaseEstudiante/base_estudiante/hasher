RAIZ = Path(__file__).resolve().parent
USUARIOS = RAIZ / "usuarios.json"

def main():

    print(">> Start Hashing <<")

    with USUARIOS.open("r", encoding="utf-8") as file:
        usuarios = json.load(file)

    for usuario in usuarios:
        #print(usuario["usuario"])
        usuario["usuario"] = crear_hash(usuario["usuario"])
        usuario["clave"] = crear_hash(usuario["clave"])
